(in-package "CL-USER")

(defvar *sketch-source-dir*
  (merge-pathnames "Github/sketch/" (translate-logical-pathname "EXTERN:")))

#+nil
(progn (pushnew :cl-sdl2 *features*)
       (pushnew :zpng *features*))

#+nil
(pushnew :glfwsketch *features*)

(assert (and (or (find :glfwsketch *features*) (find :cl-sdl2 *features*))
	     (not (and  (find :glfwsketch *features*)
			 (find :cl-sdl2 *features*))))
    nil
    "make sketch support glfw via gficl. push exactly one of :glfwsketch or :cl-sdl2 on features")

(defvar *sketch-binary-dir*
  #+cl-sdl2
  (binary-directory *sketch-source-dir*)
  #+glfwsketch
  (binary-directory *sketch-source-dir* "glfwsketch"))

;; fixme
(mk:defsystem :sketch-examples
  :source-pathname *sketch-source-dir*
  :binary-pathname *sketch-binary-dir*
  :source-extension "lisp"
  :depends-on (:alexandria
	       :sketch)
  :components ((:module "examples"
		:components ((:file "package")
			     (:file "sinewave")
			     (:file "life")
			     (:file "brownian")
			     (:file "hello-world")
			     (:file "stars")
			     (:file "indigo")
			     (:file "control-flow")
			     (:file "noise")))))

#+nil
(mk:oos :sketch-examples :load :compile-during-load t)

(mk:defsystem :sketch
  :source-pathname *sketch-source-dir*
  :binary-pathname *sketch-binary-dir*
  :source-extension "lisp"
  :depends-on (:alexandria
	       :closer-mop
	       :glkit
	       :glu-tessellate
	       :mathkit
	       (:feature (:and :jcma-libs) "jcma-md5")
	       (:feature (:not :jcma-libs) :md5)
	       :noisy
	       (:feature :cl-sdl2 :sdl2)
	       (:feature :cl-sdl2 :cl-plus-c)
	       (:feature :cl-sdl2 :sdl2-image)
	       (:feature :cl-sdl2 :sdl2-ttf)
	       (:feature :cl-sdl2 :sdl2kit)
	       :split-sequence
	       :static-vectors
	       (:feature :cl-sdl2 :trivial-garbage)
	       (:feature :zpng "zpng")
	       (:feature :glfwsketch :gficl-bt)
	       (:feature :glfwsketch :gficl/load/imlib2))
  :components ((:module "src"
		:components ((:file "package")
			     (:file "math")
			     (:file "utils")
			     (:file "environment")
			     (:file "resources")
			     (:file "color")
			     (:file "channels")
			     (:file "shaders")
			     (:file "pen")
			     (:file "font")
			     (:file "geometry")
			     (:file "image")
			     (:file "shapes")
			     (:file "transforms")
			     (:file "complex-transforms")
			     (:file "drawing")
			     (:file "bindings")
			     (:file "sketch")
			     (:file "gficl-sketch" :if-feature :glfwsketch)
			     (:file "entities")
			     (:file "figures")
			     (:file "controllers")
			     (:file "canvas")
			     (:file "noise")))))

#+nil
(mk:oos :sketch :load :compile-during-load t)
